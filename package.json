{
  "name": "convex-orchestrator",
  "version": "0.3.1",
  "private": true,
  "description": "Run multiple self-hosted Convex backend instances on a single host.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev:server": "bun run --hot src/server/index.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build:server": "bun build src/server/index.ts --target=bun --outdir=dist/server --minify",
    "build:web": "vite build --config src/web/vite.config.ts",
    "build": "bun run build:web && bun run build:server",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "test": "bun test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1054.0",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@types/bun": "^1.1.14",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  }
}
