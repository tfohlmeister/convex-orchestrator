# ---- Image (optional) ----

# Which version of the orchestrator image to run. Defaults to `latest` if
# unset, which always pulls the newest stable release from GHCR. Pin to a
# specific version (e.g. `0.1.0`) for repeatable deploys.
# ORCHESTRATOR_VERSION=0.1.0

# ---- Required ----

# The wildcard domain that the orchestrator owns. Each instance gets
# <name>.${BASE_DOMAIN} and <name>-site.${BASE_DOMAIN}. The orchestrator UI
# itself is reachable at orchestrator.${BASE_DOMAIN}.
BASE_DOMAIN=cvx.example.com

# Used to encrypt admin keys and instance secrets at rest in SQLite.
# Generate with: openssl rand -hex 32
ORCHESTRATOR_MASTER_KEY=

# Bearer token for the orchestrator API and UI. Generate with:
#   openssl rand -hex 32
# Optional. Leave empty if you front the orchestrator with your own auth
# layer (Traefik basicauth, Authelia, oauth2-proxy, Cloudflare Access, …).
# When unset, /api/* is open and the UI skips the token prompt; the
# server logs a WARN on boot.
ORCHESTRATOR_ADMIN_TOKEN=

# Postgres password for the shared instance. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# MinIO root credentials for the shared object store. Generate with: openssl rand -hex 24
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Email to register with Let's Encrypt for the wildcard cert.
ACME_EMAIL=admin@example.com

# DNS provider Traefik uses to solve the DNS-01 challenge. See
# https://doc.traefik.io/traefik/https/acme/#providers for the full list of
# supported providers and the env vars each one needs. Examples: cloudflare,
# hetzner, gandi, route53, digitalocean.
DNS_PROVIDER=cloudflare

# ---- Dev override (HTTP-only), only used by docker-compose.dev.yml ----

# Port the dev Traefik exposes on the host (since most boxes have something
# on 80/443 already). Default 18000.
TRAEFIK_HTTP_PORT=18000

# ---- Co-hosted overlay, only used by docker-compose.cohosted.yml ----

# Name of the external docker network the host's existing Traefik attaches
# services to. The orchestrator container joins this network so the host's
# Traefik can reach it by container name.
# PROXY_NETWORK=traefik-network

# Host path of the existing Traefik's --providers.file.directory. The
# orchestrator writes per-instance routers directly into this dir; the host's
# Traefik picks them up because providers.file.watch=true is already on.
# TRAEFIK_DYNAMIC_DIR_HOST=/etc/traefik/dynamic

# Loopback port the orchestrator UI binds to on the host. Reach it via
# `ssh -L <port>:localhost:<port> <host>` and open http://localhost:<port>.
# ORCHESTRATOR_UI_BIND_PORT=18000

# Resolver name the existing Traefik has configured (the <name> in its
# --certificatesresolvers.<name>.acme.* flags). Written into each
# per-instance router's `tls.certresolver`. Leave the default when running
# the bundled Traefik from the base compose file.
# TRAEFIK_CERT_RESOLVER=letsencrypt

# ---- Tunables (optional, defaults are fine for most setups) ----

# Orchestrator log verbosity: trace|debug|info|warn|error|fatal.
# LOG_LEVEL=info

# Backup scheduling. See docs/backups.md § Scheduling for the full table.
# BACKUP_SCHEDULER_ENABLED=true
# BACKUP_DEFAULT_CRON=0 3 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_MAX_CONCURRENT=2
# BACKUP_EXPORT_TIMEOUT_MINUTES=30
# BACKUP_MAX_CONSECUTIVE_FAILURES=3
# BACKUP_RETENTION_HOUR=4
# EXPORT_BLOB_CLEANUP_INTERVAL_MS=3600000
# EXPORT_BLOB_CLEANUP_MIN_AGE_MS=900000

# Scheduled per-instance backend restarts (see CHANGELOG 0.2.5).
# RESTART_SCHEDULER_ENABLED=true
# RESTART_DEFAULT_CRON=0 4 * * *

# How often the storage sampler walks each instance's MinIO buckets to
# record total size + object counts. Default 5 minutes.
# STORAGE_SAMPLE_INTERVAL_MS=300000

# Per-bucket pagination cap — stops at this many pages of 1000 keys to
# protect against a misconfigured instance with millions of objects.
# Default 100 pages = 100,000 objects per bucket per tick.
# STORAGE_SCAN_PAGE_LIMIT=100

# Fill in only the credentials for the DNS provider you actually use.
CF_DNS_API_TOKEN=
HETZNER_API_KEY=
GANDI_API_KEY=
