# ---- Required ----

# The wildcard domain that the orchestrator owns. Each instance gets
# <name>.${BASE_DOMAIN} and <name>-site.${BASE_DOMAIN}. The orchestrator UI
# itself is reachable at orchestrator.${BASE_DOMAIN}.
BASE_DOMAIN=cvx.example.com

# Used to encrypt admin keys and instance secrets at rest in SQLite.
# Generate with: openssl rand -hex 32
ORCHESTRATOR_MASTER_KEY=

# Bearer token for the orchestrator API and the dashboard deployments
# endpoint. Generate with: openssl rand -hex 32
ORCHESTRATOR_ADMIN_TOKEN=

# Postgres password for the shared instance. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# MinIO root credentials for the shared object store. Generate with: openssl rand -hex 24
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Optional UI password for the bundled MinIO console (set the same as
# MINIO_ROOT_PASSWORD if you do not need a separate one).
DASHBOARD_PASSWORD=

# Email to register with Let's Encrypt for the wildcard cert.
ACME_EMAIL=admin@example.com

# DNS provider Traefik uses to solve the DNS-01 challenge. See
# https://doc.traefik.io/traefik/https/acme/#providers for the full list of
# supported providers and the env vars each one needs. Examples: cloudflare,
# hetzner, gandi, route53, digitalocean.
DNS_PROVIDER=cloudflare

# ---- Dev override (HTTP-only) — only used by docker-compose.dev.yml ----

# Port the dev Traefik exposes on the host (since most boxes have something
# on 80/443 already). Default 18000.
TRAEFIK_HTTP_PORT=18000

# ---- Resource sampling (optional, defaults are fine for most setups) ----

# How often the storage sampler walks each instance's MinIO buckets to
# record total size + object counts. Default 5 minutes.
STORAGE_SAMPLE_INTERVAL_MS=300000

# Per-bucket pagination cap — stops at this many pages of 1000 keys to
# protect against a misconfigured instance with millions of objects.
# Default 100 pages = 100,000 objects per bucket per tick.
STORAGE_SCAN_PAGE_LIMIT=100

# Fill in only the credentials for the DNS provider you actually use.
CF_DNS_API_TOKEN=
HETZNER_API_KEY=
GANDI_API_KEY=
